{
    "name": "ianflanagan1/phpstan-inferable-var-tag-name",
    "description": "PHPStan rule reporting @var tag variable names that PHPStan can infer",
    "type": "phpstan-extension",
    "license": "MIT",
    "keywords": ["phpstan", "phpstan-extension", "phpstan-rule", "phpdoc", "static analysis"],
    "authors": [
        {
            "name": "Ian Flanagan"
        }
    ],
    "require": {
        "php": "^8.3",
        "phpstan/phpstan": "^2.1"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "IanFlanagan\\PhpstanRules\\InferableVarTagName\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IanFlanagan\\PhpstanRules\\InferableVarTagName\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/data/"
        ]
    },
    "extra": {
        "phpstan": {
            "includes": [
                "rules.neon"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
